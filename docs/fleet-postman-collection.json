						"body": {
							"mode": "raw",
							"raw": "{\n  \"bus_id\": 5,\n  \"type\": \"breakdown\",\n  \"severity\": \"high\",\n  \"description\": \"Engine overheat pada bus B 1005 UPN di Jl. Sudirman\"\n}"
