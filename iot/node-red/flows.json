[
  {
    "id": "broker_mosquitto",
    "type": "mqtt-broker",
    "broker": "mosquitto",
    "port": "1883",
    "clientid": "nodered_bridge",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "credentials": {
      "user": "",
      "password": ""
    }
  },
  {
    "id": "tab_iot_bridge",
    "type": "tab",
    "label": "IoT Smart Public Transport",
    "disabled": false
  },

  {
    "id": "gps_mqtt_in",
    "type": "mqtt in",
    "z": "tab_iot_bridge",
    "topic": "city/bus/+/gps",
    "qos": "1",
    "datatype": "json",
    "broker": "broker_mosquitto",
    "x": 160,
    "y": 100,
    "wires": [["gps_transform"]]
  },
  {
    "id": "gps_transform",
    "type": "function",
    "z": "tab_iot_bridge",
    "func": "const p = msg.payload;\n\nmsg.payload = {\n    bus_id: p.bus_id,\n    lat: p.lat,\n    lng: p.lng,\n    speed_kmh: p.speed_kmh,\n    heading: p.heading,\n    route_id: p.route_id,\n    engine_temp: p.engine_temp != null ? p.engine_temp : null,\n    recorded_at: new Date().toISOString()\n};\n\nmsg.queueFile = '/data/queue/gps-queue.jsonl';\n\nreturn msg;",
    "outputs": 1,
    "x": 410,
    "y": 100,
    "wires": [["gps_http_request"]]
  },
  {
    "id": "gps_http_request",
    "type": "http request",
    "z": "tab_iot_bridge",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://api-gateway:3000/iot/gps",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "headers": [
      {
        "keyType": "other",
        "keyValue": "Content-Type",
        "valueType": "other",
        "valueValue": "application/json"
      },
      {
        "keyType": "other",
        "keyValue": "Authorization",
        "valueType": "env",
        "valueValue": "IOT_GATEWAY_TOKEN"
      }
    ],
    "x": 660,
    "y": 100,
    "wires": [["gps_debug"]]
  },
  {
    "id": "gps_debug",
    "type": "debug",
    "z": "tab_iot_bridge",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "true",
    "x": 880,
    "y": 100,
    "wires": []
  },

  {
    "id": "pax_mqtt_in",
    "type": "mqtt in",
    "z": "tab_iot_bridge",
    "topic": "city/bus/+/passengers",
    "qos": "1",
    "datatype": "json",
    "broker": "broker_mosquitto",
    "x": 170,
    "y": 220,
    "wires": [["pax_transform"]]
  },
  {
    "id": "pax_transform",
    "type": "function",
    "z": "tab_iot_bridge",
    "func": "const p = msg.payload;\n\nmsg.payload = {\n    bus_id: p.bus_id,\n    stop_id: p.stop_id,\n    boarded: p.boarded,\n    alighted: p.alighted,\n    current_load: p.current_load,\n    capacity: p.capacity,\n    recorded_at: new Date().toISOString()\n};\n\nmsg.queueFile = '/data/queue/passenger-queue.jsonl';\n\nreturn msg;",
    "outputs": 1,
    "x": 430,
    "y": 220,
    "wires": [["pax_http_request"]]
  },
  {
    "id": "pax_http_request",
    "type": "http request",
    "z": "tab_iot_bridge",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://api-gateway:3000/iot/passengers",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "headers": [
      {
        "keyType": "other",
        "keyValue": "Content-Type",
        "valueType": "other",
        "valueValue": "application/json"
      },
      {
        "keyType": "other",
        "keyValue": "Authorization",
        "valueType": "env",
        "valueValue": "IOT_GATEWAY_TOKEN"
      }
    ],
    "x": 690,
    "y": 220,
    "wires": [["pax_debug"]]
  },
  {
    "id": "pax_debug",
    "type": "debug",
    "z": "tab_iot_bridge",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "true",
    "x": 920,
    "y": 220,
    "wires": []
  },

  {
    "id": "catch_gateway_down",
    "type": "catch",
    "z": "tab_iot_bridge",
    "scope": ["gps_http_request", "pax_http_request"],
    "uncaught": false,
    "x": 200,
    "y": 360,
    "wires": [["build_queue_line"]]
  },
  {
    "id": "build_queue_line",
    "type": "function",
    "z": "tab_iot_bridge",
    "func": "const entry = {\n    timestamp: new Date().toISOString(),\n    target: msg.url,\n    error: msg.error ? msg.error.message : 'unknown error',\n    payload: msg.payload\n};\n\nmsg.payload = JSON.stringify(entry) + '\\n';\n\nif (!msg.queueFile) {\n    msg.queueFile = '/data/queue/unknown-queue.jsonl';\n}\n\nmsg.filename = msg.queueFile;\nmsg.appendNewline = false;\n\nreturn msg;",
    "outputs": 1,
    "x": 470,
    "y": 360,
    "wires": [["write_queue_file"]]
  },
  {
    "id": "write_queue_file",
    "type": "file",
    "z": "tab_iot_bridge",
    "filename": "",
    "filenameType": "msg",
    "appendNewline": false,
    "createDir": true,
    "overwriteFile": "false",
    "encoding": "none",
    "x": 720,
    "y": 360,
    "wires": [[]]
  },

  {
    "id": "inject_requeue",
    "type": "inject",
    "z": "tab_iot_bridge",
    "props": [{ "p": "payload" }],
    "repeat": "60",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 180,
    "y": 460,
    "wires": [["requeue_note"]]
  }
]