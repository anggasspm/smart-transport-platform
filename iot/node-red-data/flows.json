    {
        "id": "gps_mqtt_in",
        "type": "mqtt in",
        "z": "tab_iot_bridge",
        "name": "Bus GPS MQTT Subscribe",
        "topic": "city/bus/+/gps",
        "qos": "1",
        "datatype": "json",
        "broker": "broker_mosquitto",
        "inputs": 0,
        "x": 160,
        "y": 100,
        "wires": [
            [
                "gps_transform"
            ]
        ]
    },
    {
        "id": "gps_transform",
        "type": "function",
        "z": "tab_iot_bridge",
        "name": "Transform GPS",
        "func": "const p = msg.payload;\nmsg.payload = {\n    bus_id:      p.bus_id,\n    lat:         p.lat,\n    lng:         p.lng,\n    speed_kmh:   p.speed_kmh,\n    heading:     p.heading,\n    route_id:    p.route_id,\n    passenger_count: p.passenger_count != null ? p.passenger_count : null,\n    engine_temp: p.engine_temp != null ? p.engine_temp : null,\n    timestamp:   new Date().toISOString()\n};\nmsg.queueFile = '/data/queue/gps-queue.jsonl';\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 100,
        "wires": [
            [
                "gps_set_headers"
            ]
        ]
    },
    {
        "id": "gps_set_headers",
        "type": "change",
        "z": "tab_iot_bridge",
        "name": "Set Headers",
        "rules": [
            {
                "t": "set",
                "p": "headers",
                "pt": "msg",
                "to": "{ \"Content-Type\": \"application/json\", \"X-IoT-Key\": \"iot-secret-key\" }",
                "tot": "json"
            }
        ],
        "x": 570,
        "y": 100,
        "wires": [
            [
                "gps_http_request"
            ]
        ]
    },
    {
        "id": "gps_http_request",
        "type": "http request",
        "z": "tab_iot_bridge",
        "name": "POST /iot/gps",
        "method": "POST",
        "ret": "obj",
        "url": "http://api-gateway:3000/iot/gps",
        "x": 760,
        "y": 100,
        "wires": [
            [
                "gps_debug"
            ]
        ]
    },
    {
        "id": "gps_debug",
        "type": "debug",
        "z": "tab_iot_bridge",
        "name": "GPS Response",
        "active": true,
        "tosidebar": true,
        "tostatus": true,
        "complete": "payload",
        "statusVal": "payload",
        "statusType": "auto",
        "x": 960,
        "y": 100,
        "wires": []
    },

