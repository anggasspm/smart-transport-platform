    {
        "id": "busstatus_parse",
        "type": "function",
        "z": "tab_iot_bridge",
        "name": "Parse Bus Status Request",
        "func": "const parts = msg.topic.split('/');\nconst stopId = parts[2];\nconst token = flow.get('iot_access_token');\nmsg.reqId = msg.payload.req_id;\nmsg.replyTo = msg.payload.reply_to;\nmsg.headers = { \"Content-Type\": \"application/json\", \"Authorization\": \"Bearer \" + (token || '') };\nmsg.url = `http://api-gateway:3000/api/stops/${stopId}/bus-status`;\nreturn msg;",
        "outputs": 1,
        "x": 430,
        "y": 460,
        "wires": [
            [
                "busstatus_http"
            ]
        ]
    },
    {
        "id": "busstatus_http",
        "type": "http request",
        "z": "tab_iot_bridge",
        "name": "GET /api/stops/:id/bus-status",
        "method": "GET",
        "ret": "obj",
        "url": "",
        "x": 700,
        "y": 460,
        "wires": [
            [
                "busstatus_build"
            ]
        ]
    },
    {
        "id": "busstatus_build",
        "type": "function",
        "z": "tab_iot_bridge",
        "name": "Build Bus Status Response",
        "func": "msg.payload = JSON.stringify({\n    req_id: msg.reqId,\n    ok: msg.statusCode === 200,\n    data: msg.payload ? msg.payload.data : null\n});\nmsg.topic = msg.replyTo;\nreturn msg;",
        "outputs": 1,
        "x": 940,
        "y": 460,
        "wires": [
            [
                "busstatus_mqtt_out"
            ]
        ]
    },
