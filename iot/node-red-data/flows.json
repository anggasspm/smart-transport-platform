    {
        "id": "catch_gateway_down",
        "type": "catch",
        "z": "tab_iot_bridge",
        "name": "Catch Gateway Error",
        "scope": [
            "gps_http_request",
            "pax_http_request"
        ],
        "uncaught": false,
        "x": 220,
        "y": 360,
        "wires": [
            [
                "build_queue_line"
            ]
        ]
    },
    {
        "id": "build_queue_line",
        "type": "function",
        "z": "tab_iot_bridge",
        "name": "Build Queue Entry",
        "func": "const entry = {\n    timestamp: new Date().toISOString(),\n    target:    msg.url || 'unknown',\n    error:     msg.error ? msg.error.message : 'unknown',\n    payload:   msg.payload\n};\nmsg.payload      = JSON.stringify(entry) + '\\n';\nmsg.filename     = msg.queueFile || '/data/queue/unknown-queue.jsonl';\nmsg.appendNewline = false;\nreturn msg;",
        "outputs": 1,
        "x": 470,
        "y": 360,
        "wires": [
            [
                "write_queue_file"
            ]
        ]
    },
    {
        "id": "write_queue_file",
        "type": "file",
        "z": "tab_iot_bridge",
        "name": "Write to Queue",
        "filename": "",
        "filenameType": "msg",
        "appendNewline": false,
        "createDir": true,
        "overwriteFile": "false",
        "x": 700,
        "y": 360,
        "wires": [
            []
        ]
    },

    {
        "id": "busstatus_mqtt_in",
        "type": "mqtt in",
        "z": "tab_iot_bridge",
        "name": "Bus Status GET Subscribe",
        "topic": "city/stop/+/bus-status/get",
        "qos": "1",
        "datatype": "json",
        "broker": "broker_mosquitto",
        "inputs": 0,
        "x": 180,
        "y": 460,
        "wires": [
            [
                "busstatus_parse"
            ]
        ]
    },
    {
        "id": "busstatus_parse",
        "type": "function",
        "z": "tab_iot_bridge",
        "name": "Parse Bus Status Request",
        "func": "const parts = msg.topic.split('/');\nconst stopId = parts[2];\nmsg.reqId = msg.payload.req_id;\nmsg.replyTo = msg.payload.reply_to;\nmsg.headers = { \"Content-Type\": \"application/json\", \"X-IoT-Key\": \"iot-secret-key\" };\nmsg.url = `http://api-gateway:3000/api/stops/${stopId}/bus-status`;\nreturn msg;",
        "outputs": 1,
        "x": 430,
        "y": 460,
        "wires": [
            [
                "busstatus_http"
            ]
        ]
    },
    {
        "id": "busstatus_http",
        "type": "http request",
        "z": "tab_iot_bridge",
        "name": "GET /api/stops/:id/bus-status",
        "method": "GET",
        "ret": "obj",
        "url": "",
        "x": 700,
        "y": 460,
        "wires": [
            [
                "busstatus_build"
            ]
        ]
    },
    {
        "id": "busstatus_build",
        "type": "function",
        "z": "tab_iot_bridge",
        "name": "Build Bus Status Response",
        "func": "msg.payload = JSON.stringify({\n    req_id: msg.reqId,\n    ok: msg.statusCode === 200,\n    data: msg.payload ? msg.payload.data : null\n});\nmsg.topic = msg.replyTo;\nreturn msg;",
        "outputs": 1,
        "x": 940,
        "y": 460,
        "wires": [
            [
                "busstatus_mqtt_out"
            ]
        ]
    },
    {
        "id": "busstatus_mqtt_out",
        "type": "mqtt out",
        "z": "tab_iot_bridge",
        "name": "Bus Status Reply Publish",
        "topic": "",
        "qos": "1",
        "retain": "",
        "broker": "broker_mosquitto",
        "x": 1180,
        "y": 460,
        "wires": []
    },

