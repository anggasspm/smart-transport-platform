CI_ENVIRONMENT = production

# URL service ini (diisi sesuai host:port)
app.baseURL = http://localhost:8001/
app.indexPage =

# ─── Database (CI4 .env format) ────────────────────────────────
# Format ini dibaca langsung oleh CI4 framework
database.default.hostname = mysql
database.default.database = smarttransport
database.default.username = root
database.default.password = rootpass
database.default.DBDriver = MySQLi
database.default.port     = 3306

# ─── Database (Docker Compose env var format) ──────────────────
# Format ini dibaca oleh app/Config/Database.php constructor
# Keduanya bisa dipakai, Docker-style lebih prioritas
DB_HOST = mysql
DB_PORT = 3306
DB_NAME = smarttransport
DB_USER = root
DB_PASS = rootpass

# ─── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_HOST     = rabbitmq
RABBITMQ_PORT     = 5672
RABBITMQ_USER     = admin
RABBITMQ_PASS     = adminpass
RABBITMQ_EXCHANGE = city.events

# ─── Service Identity ──────────────────────────────────────────
SERVICE_NAME = fleet-service
