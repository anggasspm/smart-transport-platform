# =============================================================================
# Fleet Service — Environment Configuration
# Copy this file to .env and adjust values for your environment
# =============================================================================

CI_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
app.baseURL=http://localhost:8001/

# ---------------------------------------------------------------------------
# Database (MySQL — Docker service name: mysql)
# ---------------------------------------------------------------------------
database.default.hostname=mysql
database.default.database=smarttransport
database.default.username=root
database.default.password=rootpass
database.default.DBDriver=MySQLi
database.default.DBPrefix=
database.default.port=3306

# ---------------------------------------------------------------------------
# RabbitMQ (Docker service name: rabbitmq)
# ---------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_EXCHANGE=city.events
