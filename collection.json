            "method": "POST",
            "url": "{{fleet_direct_url}}/api/incidents",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bus_id\": {{bus_id}},\n  \"type\": \"breakdown\",\n  \"severity\": \"medium\",\n  \"description\": \"Ban bocor\"\n}"
            },
            "description": "KNOWN GAP: /api/incidents tidak ada di proxyRoutes.js gateway, jadi akses LANGSUNG ke php-fleet port 8001."
          }
        },
        {
          "name": "GET List Incidents (DIRECT)",
          "request": { "method": "GET", "url": "{{fleet_direct_url}}/api/incidents" }
        },
